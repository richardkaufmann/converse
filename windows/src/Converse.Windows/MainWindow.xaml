<Window
    x:Class="Converse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Converse.App"
    mc:Ignorable="d"
    Title="Converse">
    <Grid>
    <!-- Resources live on the root Grid: WinUI 3's Window has no Resources
         property, and <Window.Resources> makes XamlCompiler.exe exit 1 with
         no diagnostic. Classic {Binding} only throughout. -->
    <Grid.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:ActiveToBackgroundConverter x:Key="ActiveBg"/>
        <local:ActiveToForegroundConverter x:Key="ActiveFg"/>
        <DataTemplate x:Key="SidebarHeaderTemplate">
            <Grid Padding="8,7,8,2" Opacity="{Binding Opacity}" ToolTipService.ToolTip="{Binding Details}">
              <Grid.ContextFlyout><MenuFlyout>
                <MenuFlyoutItem Text="Rename device…" Tag="{Binding}" Click="OnRenameDevice" Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}"/>
              </MenuFlyout></Grid.ContextFlyout>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="{Binding Weight}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Status}" FontSize="11" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
              </StackPanel>
              <Button Grid.Column="1" Content="+ ▾" Tag="{Binding}" Click="OnRemoteCreateMenu" Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="Create a session on this device"/>
            </Grid>
        </DataTemplate>
        <!-- Sessions nest under their home header; 1/2/3 take remote
             sessions as they place (Mac parity), so no separate Take. -->
        <DataTemplate x:Key="SidebarSessionTemplate">
            <Grid Padding="18,3,4,3">
                <Grid.ContextFlyout><MenuFlyout>
                    <MenuFlyoutItem Text="Rename…" IsEnabled="{Binding CanEdit}" Tag="{Binding}" Click="OnRenameRow"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Agent Setup / Loop" Tag="{Binding}" Click="OnAgentSetupRow"/>
                    <MenuFlyoutItem Text="Teach Session To Talk To Other Sessions" IsEnabled="{Binding CanEdit}" Tag="{Binding}" Click="OnTeachRow"/>
                    <MenuFlyoutItem Text="Teach Converse Setup &amp; Control" IsEnabled="{Binding CanEdit}" Tag="{Binding}" Click="OnTeachAppRow"/>
                    <MenuFlyoutItem Text="Disable app control" Tag="{Binding}" Click="OnDisableAppRow"/>
                </MenuFlyout></Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="🕵️" Margin="4,0,4,0" Visibility="{Binding IsAgent, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="Agent session" AutomationProperties.Name="Agent"/>
                    </Grid>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <local:ProviderIcon Grid.Column="1" Engine="{Binding Engine}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Model}"/>
                <!-- P 1 2 3 X (Mac order). The active button prints white on
                     the Mac green; X is always the destructive dark red. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Content="P" Click="OnParkClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowPark, Converter={StaticResource BoolToVis}}"
                            Background="{Binding PActive, Converter={StaticResource ActiveBg}}"
                            Foreground="{Binding PActive, Converter={StaticResource ActiveFg}}"
                            ToolTipService.ToolTip="Park (release this conversation to its home)"/>
                    <Button Content="1" Click="OnPlaceClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowPlace, Converter={StaticResource BoolToVis}}"
                            Background="{Binding In1, Converter={StaticResource ActiveBg}}"
                            Foreground="{Binding In1, Converter={StaticResource ActiveFg}}"
                            ToolTipService.ToolTip="Show in pane 1 (takes remote sessions here)"/>
                    <Button Content="2" Click="OnPlaceClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowPlace, Converter={StaticResource BoolToVis}}"
                            Background="{Binding In2, Converter={StaticResource ActiveBg}}"
                            Foreground="{Binding In2, Converter={StaticResource ActiveFg}}"
                            ToolTipService.ToolTip="Show in pane 2 (takes remote sessions here)"/>
                    <Button Content="3" Click="OnPlaceClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowPlace, Converter={StaticResource BoolToVis}}"
                            Background="{Binding In3, Converter={StaticResource ActiveBg}}"
                            Foreground="{Binding In3, Converter={StaticResource ActiveFg}}"
                            ToolTipService.ToolTip="Show in pane 3 (takes remote sessions here)"/>
                    <Button Content="X" Click="OnCloseClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowClose, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Close session (keeps a recovery archive)"/>
                    <Button Content="X" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowGreyClose, Converter={StaticResource BoolToVis}}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Remote sessions close on their home device"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <local:SidebarTemplateSelector x:Key="SidebarSelector"
            HeaderTemplate="{StaticResource SidebarHeaderTemplate}"
            SessionTemplate="{StaticResource SidebarSessionTemplate}"/>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Converse">
                <MenuFlyoutItem Text="Setup" Click="OnSetupClick"/>
                <MenuFlyoutItem x:Name="ResetDemoItem" Text="Reset Demo…" Click="OnResetDemo" Visibility="Collapsed"/>
                <MenuFlyoutItem Text="Set up Linux…" Click="OnLinuxClick"/>
                <MenuFlyoutItem Text="Converse Groups…" Click="OnGroupsClick"/>
                <MenuFlyoutItem Text="Connect to Other Converses…" Click="OnConnectClick"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="New session" Click="OnNewSessionClick"/>
                <MenuFlyoutItem Text="New agent…" Click="OnNewAgentClick"/>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Converse Help" Click="OnHelpClick"/>
                <MenuFlyoutItem Text="Converse App Support…" Click="OnAppSupport"/>
                <MenuFlyoutItem Text="Report a Bug on GitHub…" Click="OnReportBug"/>
                <MenuFlyoutItem Text="Security &amp; Privacy" Click="OnSecurityHelp"/>
                <MenuFlyoutItem Text="About Converse…" Click="OnAboutClick"/>
            </MenuBarItem>
        </MenuBar>
        <Grid Grid.Row="1" SizeChanged="OnRootSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="340"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="SidebarPanel" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Padding="8,8,8,4" VerticalAlignment="Center">
                    <!-- Pin immediately left of the Conversation header: collapse/restore is layout only. -->
                    <Button x:Name="CollapsePin" Click="OnPinClick" Width="28" Height="28" Padding="4"
                            Background="Transparent" BorderThickness="0" AutomationProperties.Name="Hide conversation sidebar"
                            ToolTipService.ToolTip="Hide conversation sidebar">
                        <SymbolIcon Symbol="Pin"/>
                    </Button>
                    <TextBlock Text="Conversations" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="Sidebar" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSidebarSelection"
                          ItemTemplateSelector="{StaticResource SidebarSelector}"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="8">
                    <Button Content="New session" Click="OnNewSessionClick"/>
                    <Button Content="Groups…" Click="OnGroupsClick"/>
                    <Button Content="Connect…" Click="OnConnectClick"/>
                </StackPanel>
            </Grid>
            <Border x:Name="Splitter" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    PointerPressed="OnSplitterPressed" PointerMoved="OnSplitterMoved" PointerReleased="OnSplitterReleased"/>
            <!-- Visible conversations (Mac WorkspacePanes parity): occupied
                 slots share the finite width equally and scroll vertically
                 on their own; the window's minimum width grows with the
                 pane count so a new pane never arrives as a sliver. The
                 restore pin floats above so it stays reachable while the
                 sidebar is collapsed. -->
            <Grid Grid.Column="2">
                <Grid x:Name="PaneHost"/>
                <Button x:Name="RestorePin" Click="OnPinClick" Visibility="Collapsed" Width="28" Height="28" Padding="4"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderThickness="0"
                        AutomationProperties.Name="Show conversation sidebar" ToolTipService.ToolTip="Restore sidebar at its previous width">
                    <SymbolIcon Symbol="Pin"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
