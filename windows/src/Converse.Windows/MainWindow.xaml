<Window
    x:Class="Converse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Converse.App"
    mc:Ignorable="d"
    Title="Converse">
    <Grid>
    <!-- Resources live on the root Grid: WinUI 3's Window has no Resources
         property, and <Window.Resources> makes XamlCompiler.exe exit 1 with
         no diagnostic. Classic {Binding} only throughout. -->
    <Grid.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="SidebarHeaderTemplate">
            <StackPanel Padding="8,7,8,2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Status}" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SidebarSessionTemplate">
            <Grid Padding="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Content="P" Click="OnParkClick" Tag="{Binding}"
                            Visibility="{Binding ShowPark, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Park (leave this conversation here)"/>
                    <Button Content="1" Click="OnTakeClick" Tag="{Binding}"
                            Visibility="{Binding ShowTake, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Take here"/>
                    <Button Content="2" Click="OnTakeClick" Tag="{Binding}"
                            Visibility="{Binding ShowTake, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Take to second pane"/>
                    <Button Content="3" Click="OnTakeClick" Tag="{Binding}"
                            Visibility="{Binding ShowTake, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Take to third pane"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <local:SidebarTemplateSelector x:Key="SidebarSelector"
            HeaderTemplate="{StaticResource SidebarHeaderTemplate}"
            SessionTemplate="{StaticResource SidebarSessionTemplate}"/>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Converse">
                <MenuFlyoutItem Text="Setup" Click="OnSetupClick"/>
                <MenuFlyoutItem Text="Connect to Other Converses…" Click="OnConnectClick"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="New session" Click="OnNewSessionClick"/>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Converse Help" Click="OnHelpClick"/>
            </MenuBarItem>
        </MenuBar>
        <Grid Grid.Row="1" SizeChanged="OnRootSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="340"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="SidebarPanel" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Padding="8,8,8,4" VerticalAlignment="Center">
                    <!-- Pin immediately left of the Conversation header: collapse/restore is layout only. -->
                    <Button x:Name="CollapsePin" Content="Pin" Click="OnPinClick"
                            ToolTipService.ToolTip="Collapse sidebar (sessions and leases are unaffected)"/>
                    <TextBlock Text="Conversations" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="Sidebar" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSidebarSelection"
                          ItemTemplateSelector="{StaticResource SidebarSelector}"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="8">
                    <Button Content="New session" Click="OnNewSessionClick"/>
                    <Button Content="Connect…" Click="OnConnectClick"/>
                </StackPanel>
            </Grid>
            <Border x:Name="Splitter" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    PointerPressed="OnSplitterPressed" PointerMoved="OnSplitterMoved" PointerReleased="OnSplitterReleased"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,6" VerticalAlignment="Center">
                    <!-- Restore pin stays reachable with the transcript when the sidebar is collapsed. -->
                    <Button x:Name="RestorePin" Content="Pin" Click="OnPinClick" Visibility="Collapsed"
                            ToolTipService.ToolTip="Restore sidebar at its previous width"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PaneTitle" FontWeight="SemiBold" Text="No conversation selected"/>
                        <TextBlock x:Name="PaneSubtitle" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text=""/>
                    </StackPanel>
                </StackPanel>
                <!-- One seamless document: protected history plus an editable blue draft tail. -->
                <RichEditBox x:Name="Transcript" Grid.Row="1" Margin="8,0" FontSize="16"
                             PlaceholderText="Select a conversation to begin."
                             IsSpellCheckEnabled="True"
                             PreviewKeyDown="OnTranscriptKeyDown"
                             TextChanged="OnTranscriptTextChanged"/>
                <Grid Grid.Row="2" Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Type at the end in blue. Return sends · Ctrl+Return for newline"/>
                    <Button Grid.Column="1" Content="Stop" Margin="6,0,0,0" Click="OnStopClick"/>
                    <Button Grid.Column="2" Content="Send" Margin="6,0,0,0" Click="OnSendClick"/>
                </Grid>
                <StackPanel x:Name="SettingsRow" Grid.Row="3" Orientation="Horizontal" Spacing="6" Padding="8,0,8,8" VerticalAlignment="Center">
                    <TextBlock Text="Model:" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="ModelBox" Width="200" IsEditable="True" FontSize="12"
                              SelectionChanged="OnSettingChanged" LostFocus="OnModelCommitted" KeyDown="OnModelKeyDown"/>
                    <TextBlock Text="Effort:" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
                    <ComboBox x:Name="EffortBox" Width="130" FontSize="12" SelectionChanged="OnSettingChanged"/>
                    <TextBlock Text="Access:" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
                    <ComboBox x:Name="AccessBox" Width="200" FontSize="12" SelectionChanged="OnSettingChanged"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
