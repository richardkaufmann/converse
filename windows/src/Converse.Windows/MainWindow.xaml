<Window
    x:Class="Converse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Converse.App"
    mc:Ignorable="d"
    Title="Converse">
    <Grid>
    <!-- Resources live on the root Grid: WinUI 3's Window has no Resources
         property, and <Window.Resources> makes XamlCompiler.exe exit 1 with
         no diagnostic. Classic {Binding} only throughout. -->
    <Grid.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="SidebarHeaderTemplate">
            <StackPanel Padding="8,7,8,2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Status}" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </DataTemplate>
        <!-- Sessions nest under their home header; 1/2/3 take remote
             sessions as they place (Mac parity), so no separate Take. -->
        <DataTemplate x:Key="SidebarSessionTemplate">
            <Grid Padding="18,3,4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Content="1" Click="OnPlaceClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowPlace, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Show in pane 1 (takes remote sessions here)"/>
                    <Button Content="2" Click="OnPlaceClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowPlace, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Show in pane 2 (takes remote sessions here)"/>
                    <Button Content="3" Click="OnPlaceClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowPlace, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Show in pane 3 (takes remote sessions here)"/>
                    <Button Content="P" Click="OnParkClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowPark, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Park (release this conversation to its home)"/>
                    <Button Content="X" Click="OnCloseClick" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowClose, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Close session (keeps a recovery archive)"/>
                    <Button Content="X" Tag="{Binding}" FontSize="12" Width="30" Height="28" Padding="0"
                            Visibility="{Binding ShowGreyClose, Converter={StaticResource BoolToVis}}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Remote sessions close on their home device"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <local:SidebarTemplateSelector x:Key="SidebarSelector"
            HeaderTemplate="{StaticResource SidebarHeaderTemplate}"
            SessionTemplate="{StaticResource SidebarSessionTemplate}"/>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Converse">
                <MenuFlyoutItem Text="Setup" Click="OnSetupClick"/>
                <MenuFlyoutItem Text="Converse Groups…" Click="OnGroupsClick"/>
                <MenuFlyoutItem Text="Connect to Other Converses…" Click="OnConnectClick"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="New session" Click="OnNewSessionClick"/>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Converse Help" Click="OnHelpClick"/>
            </MenuBarItem>
        </MenuBar>
        <Grid Grid.Row="1" SizeChanged="OnRootSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="340"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="SidebarPanel" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Padding="8,8,8,4" VerticalAlignment="Center">
                    <!-- Pin immediately left of the Conversation header: collapse/restore is layout only. -->
                    <Button x:Name="CollapsePin" Content="Pin" Click="OnPinClick"
                            ToolTipService.ToolTip="Collapse sidebar (sessions and leases are unaffected)"/>
                    <TextBlock Text="Conversations" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="Sidebar" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSidebarSelection"
                          ItemTemplateSelector="{StaticResource SidebarSelector}"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="8">
                    <Button Content="New session" Click="OnNewSessionClick"/>
                    <Button Content="Groups…" Click="OnGroupsClick"/>
                    <Button Content="Connect…" Click="OnConnectClick"/>
                </StackPanel>
            </Grid>
            <Border x:Name="Splitter" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    PointerPressed="OnSplitterPressed" PointerMoved="OnSplitterMoved" PointerReleased="OnSplitterReleased"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Restore pin stays reachable with the transcript when the sidebar is collapsed. -->
                        <Button x:Name="RestorePin" Content="Pin" Click="OnPinClick" Visibility="Collapsed"
                                ToolTipService.ToolTip="Restore sidebar at its previous width"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PaneTitle" FontWeight="SemiBold" Text="No conversation selected"/>
                            <TextBlock x:Name="PaneSubtitle" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text=""/>
                        </StackPanel>
                        <!-- Pane slots 1-3: assignments persist, focus follows clicks. Rebuilt in code behind. -->
                        <StackPanel x:Name="PaneBar" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <!-- Appears when scrolled up: one click back to the newest messages. -->
                        <Button x:Name="JumpLatestButton" Content="↓ Latest" Click="OnJumpLatestClick" Visibility="Collapsed"
                                FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Back to the newest messages"/>
                    </StackPanel>
                    <!-- Take appears for a remote session this window is not viewing yet. -->
                    <Button x:Name="TakeButton" Grid.Column="1" Content="Take here" Click="OnTakeHereClick"
                            Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0"/>
                    <!-- The Windows beachball: indeterminate ring while the session works. -->
                    <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="20" Height="20"
                                  IsActive="False" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Session is working"/>
                </Grid>
                <!-- Approvals, questions, queued prompts and outbox recovery.
                     Built in code behind; Mac shows the same stack above the editor. -->
                <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                              x:Name="BannerScroller" Visibility="Collapsed">
                    <StackPanel x:Name="BannerStack" Spacing="6" Margin="8,0"/>
                </ScrollViewer>
                <Button x:Name="EarlierButton" Grid.Row="2" Margin="8,4,8,0" Visibility="Collapsed"
                        HorizontalAlignment="Left" Click="OnEarlierClick" Content="Load earlier messages"/>
                <Grid Grid.Row="3" Margin="8,4,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Line-number gutter, Mac parity: one number per paragraph,
                         prompt paragraphs tinted, scrolled in lockstep with the editor. -->
                    <ScrollViewer x:Name="GutterScroller" Grid.Column="0"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                        <TextBlock x:Name="LineGutter" FontSize="16" MinWidth="28" Margin="0,0,0,0"
                                   Padding="0,0,6,0" TextAlignment="Right" LineHeight="24"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </ScrollViewer>
                    <!-- One seamless document: protected history plus an editable blue draft tail.
                         Spellcheck stays off: the control's background spelling pass over a
                         25k+ char formatted transcript is the prime crash suspect (see
                         crash12/ dump analysis), and it is pointless on a transcript. -->
                    <RichEditBox x:Name="Transcript" Grid.Column="1" FontSize="16" Padding="0"
                                 PlaceholderText="Select a conversation to begin."
                                 IsSpellCheckEnabled="False"
                                 PreviewKeyDown="OnTranscriptKeyDown"
                                 TextChanged="OnTranscriptTextChanged">
                        <RichEditBox.ContextFlyout>
                            <MenuFlyout Opening="OnContextMenuOpening">
                                <MenuFlyoutItem Text="Copy" Click="OnCopyClick"/>
                                <MenuFlyoutItem Text="Select all" Click="OnSelectAllClick"/>
                                <MenuFlyoutSeparator x:Name="CopyMessageSeparator"/>
                                <MenuFlyoutItem x:Name="CopyMessageItem" Text="Copy" Click="OnCopyMessageClick"/>
                            </MenuFlyout>
                        </RichEditBox.ContextFlyout>
                    </RichEditBox>
                </Grid>
                <Grid Grid.Row="4" Padding="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Type at the end in blue. Return sends or queues · Ctrl+Return for newline"/>
                    <CheckBox x:Name="LineNumbersBox" Grid.Column="1" Content="line numbers" FontSize="11"
                              VerticalAlignment="Center" Margin="8,0,0,0"
                              Checked="OnLineNumbersToggled" Unchecked="OnLineNumbersToggled"
                              ToolTipService.ToolTip="Show the transcript line-number gutter"/>
                    <Button x:Name="AttachButton" Grid.Column="2" Content="Attach" Margin="8,0,0,0" Click="OnAttachClick"
                            ToolTipService.ToolTip="Attach an image to the draft"/>
                    <Button x:Name="ClearImagesButton" Grid.Column="3" Content="Clear images" Margin="8,0,0,0"
                            Click="OnClearImagesClick" Visibility="Collapsed"/>
                    <Button x:Name="StopButton" Grid.Column="4" Content="Stop" Margin="8,0,0,0" Click="OnStopClick"/>
                    <Button x:Name="SendButton" Grid.Column="5" Content="Send" Margin="8,0,0,0" Click="OnSendClick"/>
                </Grid>
                <StackPanel x:Name="SettingsRow" Grid.Row="5" Orientation="Horizontal" Spacing="6" Padding="8,0,8,8" VerticalAlignment="Center">
                    <TextBlock Text="Model:" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="ModelBox" Width="200" IsEditable="True" FontSize="12"
                              SelectionChanged="OnSettingChanged" GotFocus="OnModelGotFocus" LostFocus="OnModelCommitted"
                              TextSubmitted="OnModelTextSubmitted"/>
                    <TextBlock Text="Effort:" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
                    <ComboBox x:Name="EffortBox" Width="130" FontSize="12" SelectionChanged="OnSettingChanged"/>
                    <TextBlock Text="Access:" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
                    <ComboBox x:Name="AccessBox" Width="200" FontSize="12" SelectionChanged="OnSettingChanged"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
