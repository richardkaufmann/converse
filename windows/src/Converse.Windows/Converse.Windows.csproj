<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unpackaged WinUI 3. Build on Windows 11 with the .NET 8 SDK:
       dotnet build windows/src/Converse.Windows -c Release -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Converse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Converse.Core/Converse.Core.csproj" />
    <Content Include="../../../Resources/ProviderLogos/*.png;../../../Resources/ProviderLogos/NOTICE.txt;../../../Resources/ProviderLogos/LICENSE.md">
      <Link>Assets/ProviderLogos/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Offline Help: generated at build time from the tracked README by the
       shared scripts/build-help.py (never checked in). The Exec is
       best-effort so a machine without Python still builds; Help then shows
       an explicit not-included notice instead of stale content. -->
  <Target Name="GenerateHelp" BeforeTargets="AssignTargetPaths">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\..\..\scripts\build-help.py&quot; --out &quot;$(MSBuildProjectDirectory)\Assets\help.json&quot;"
          IgnoreExitCode="true" ContinueOnError="true" />
    <Exec Command="py &quot;$(MSBuildProjectDirectory)\..\..\..\scripts\build-help.py&quot; --out &quot;$(MSBuildProjectDirectory)\Assets\help.json&quot;"
          Condition="!Exists('$(MSBuildProjectDirectory)\Assets\help.json')"
          IgnoreExitCode="true" ContinueOnError="true" />
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\Assets\help.json')">
      <Content Include="$(MSBuildProjectDirectory)\Assets\help.json">
        <Link>Assets\help.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
