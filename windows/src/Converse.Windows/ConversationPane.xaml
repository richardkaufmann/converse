<UserControl
    x:Class="Converse.App.ConversationPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="300">
    <!-- One visible conversation (Mac SessionPane parity): header with the
         pane badge, banners, earlier paging, block transcript plus the
         persistent draft tail, action row, and model/effort/access. -->
    <Grid PointerPressed="OnPanePointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="PaneHeader" Grid.Row="0" Margin="8,6" PointerPressed="OnPaneHeaderPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Pane badge: its number, click to focus. The host tints
                     the focused pane's badge. -->
                <Button x:Name="PaneBadge" Content="—" Click="OnBadgeClick"
                        FontSize="11" FontWeight="SemiBold" MinWidth="28"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Focus this pane"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PaneTitle" FontWeight="SemiBold" Text="No conversation selected"/>
                    <TextBlock x:Name="PaneSubtitle" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text=""/>
                </StackPanel>
            </StackPanel>
            <!-- Take appears for a remote session this window is not viewing yet. -->
            <Button x:Name="TakeButton" Grid.Column="1" Content="Take here" Click="OnTakeHereClick"
                    Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0"/>
            <!-- The Windows beachball: indeterminate ring while the session works. -->
            <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="20" Height="20"
                          IsActive="False" VerticalAlignment="Center"
                          ToolTipService.ToolTip="Session is working"/>
        </Grid>
        <!-- Approvals, questions, queued prompts and outbox recovery.
             Built in code behind; Mac shows the same stack above the editor. -->
        <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                      x:Name="BannerScroller" Visibility="Collapsed">
            <StackPanel x:Name="BannerStack" Spacing="6" Margin="8,0"/>
        </ScrollViewer>
        <Button x:Name="EarlierButton" Grid.Row="2" Margin="8,4,8,0" Visibility="Collapsed"
                HorizontalAlignment="Left" Click="OnEarlierClick" Content="Load earlier messages"/>
        <!-- Block transcript, Mac parity: each message is its own read-only
             block (RichTextBlock text, real Grid tables), every message
             carrying its number chip, prompts on the light-blue ground.
             The draft is one persistent editable tail block, blue like the
             Mac's, and no rich-edit document is ever rebuilt or mutated. -->
        <!-- Latest-jump floats over the transcript's lower-right corner
             (Mac parity), not in the header. -->
        <Grid Grid.Row="3" Margin="8,4,8,0">
            <ScrollViewer x:Name="TranscriptScroller"
                          ViewChanged="OnTranscriptScrolled"
                          PointerPressed="OnTranscriptPressed"
                          PointerMoved="OnTranscriptMoved"
                          PointerReleased="OnTranscriptReleased">
                <StackPanel x:Name="TranscriptStack" Spacing="10">
                    <RichEditBox x:Name="DraftBox" FontSize="16" Padding="0" AcceptsReturn="True"
                                 PlaceholderText="Select a conversation to begin."
                                 IsSpellCheckEnabled="False" BorderThickness="0"
                                 PreviewKeyDown="OnDraftKeyDown"
                                 TextChanged="OnDraftTextChanged"
                                 GotFocus="OnDraftGotFocus"/>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="JumpLatestButton" Content="↓ Latest" Click="OnJumpLatestClick" Visibility="Collapsed"
                    FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                    ToolTipService.ToolTip="Back to the newest messages"/>
        </Grid>
        <Grid Grid.Row="4" Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Type at the end in blue. Return sends or queues · Ctrl+Return for newline"/>
            <CheckBox x:Name="LineNumbersBox" Grid.Column="1" Content="line numbers" FontSize="11"
                      VerticalAlignment="Center" Margin="8,0,0,0"
                      Checked="OnLineNumbersToggled" Unchecked="OnLineNumbersToggled"
                      ToolTipService.ToolTip="Show message numbers"/>
            <Button x:Name="AttachButton" Grid.Column="2" Content="Attach" Margin="8,0,0,0" Click="OnAttachClick"
                    ToolTipService.ToolTip="Attach an image to the draft"/>
            <Button x:Name="ClearImagesButton" Grid.Column="3" Content="Clear images" Margin="8,0,0,0"
                    Click="OnClearImagesClick" Visibility="Collapsed"/>
            <Button x:Name="StopButton" Grid.Column="4" Content="Stop" Margin="8,0,0,0" Click="OnStopClick"/>
            <Button x:Name="SendButton" Grid.Column="5" Content="Send" Margin="8,0,0,0" Click="OnSendClick"/>
        </Grid>
        <StackPanel x:Name="SettingsRow" Grid.Row="5" Orientation="Horizontal" Spacing="6" Padding="8,0,8,8" VerticalAlignment="Center">
            <TextBlock Text="Model:" VerticalAlignment="Center" FontSize="12"/>
            <ComboBox x:Name="ModelBox" Width="200" IsEditable="True" FontSize="12"
                      SelectionChanged="OnSettingChanged" GotFocus="OnModelGotFocus" LostFocus="OnModelCommitted"
                      TextSubmitted="OnModelTextSubmitted"/>
            <TextBlock Text="Effort:" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
            <ComboBox x:Name="EffortBox" Width="130" FontSize="12" SelectionChanged="OnSettingChanged"/>
            <TextBlock Text="Access:" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
            <ComboBox x:Name="AccessBox" Width="200" FontSize="12" SelectionChanged="OnSettingChanged"/>
        </StackPanel>
    </Grid>
</UserControl>
