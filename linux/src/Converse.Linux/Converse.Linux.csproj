<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Converse.Linux</AssemblyName>
    <RootNamespace>Converse.Linux</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Direct builds and tests use the same identity as packaged releases. -->
    <ConverseVersionJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../VERSION.json'))</ConverseVersionJson>
    <Version>$([System.Text.RegularExpressions.Regex]::Match('$(ConverseVersionJson)', '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <ConverseBuildNumber>$([System.Text.RegularExpressions.Regex]::Match('$(ConverseVersionJson)', '&quot;build&quot;\s*:\s*(\d+)').Groups[1].Value)</ConverseBuildNumber>
    <InformationalVersion>$(Version)+$(ConverseBuildNumber)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(ConverseSourceCommit)' != ''">
      <_Parameter1>ConverseSourceCommit</_Parameter1>
      <_Parameter2>$(ConverseSourceCommit)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <ProjectReference Include="../../../windows/src/Converse.Core/Converse.Core.csproj" />
    <InternalsVisibleTo Include="Converse.Linux.Tests" />
  </ItemGroup>
</Project>
