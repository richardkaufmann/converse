{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:converse:linux:status:v1",
  "title": "Converse Linux status v1",
  "type": "object",
  "required": [
    "product",
    "productVersion",
    "build",
    "sourceCommit",
    "architecture",
    "device",
    "protocols",
    "runtime",
    "filesystem",
    "fabric",
    "work",
    "release",
    "secrets",
    "capabilities"
  ],
  "properties": {
    "product": { "const": "Converse" },
    "productVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "build": { "type": "integer", "minimum": 0 },
    "sourceCommit": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    },
    "architecture": { "enum": ["x64", "arm64", "unknown"] },
    "device": {
      "type": "object",
      "required": ["deviceID", "name"],
      "properties": {
        "deviceID": {
          "anyOf": [
            { "$ref": "#/$defs/deviceID" },
            { "type": "null" }
          ]
        },
        "name": { "type": "string", "maxLength": 200 }
      }
    },
    "protocols": {
      "type": "object",
      "required": [
        "deviceProtocolVersion",
        "adminApiVersion",
        "stateSchemaVersion",
        "recoveryLedgerVersion"
      ],
      "properties": {
        "deviceProtocolVersion": { "const": 1 },
        "adminApiVersion": { "const": 1 },
        "stateSchemaVersion": { "type": "integer", "minimum": 1 },
        "recoveryLedgerVersion": { "const": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["processState", "supervisor", "desiredRunning", "startedAt", "admission"],
      "properties": {
        "processState": {
          "enum": ["not_installed", "starting", "running", "stopping", "stopped", "recovery_required"]
        },
        "supervisor": {
          "enum": ["none", "systemd-user", "cron-fallback", "manual-test"]
        },
        "desiredRunning": { "type": "boolean" },
        "startedAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "admission": {
          "enum": [
            "open",
            "closed_draining",
            "closed_probation",
            "closed_recovery",
            "closed_not_installed",
            "closed_stopped"
          ]
        }
      }
    },
    "filesystem": {
      "type": "object",
      "required": ["installRoot", "stateRoot", "configRoot", "dataRoot"],
      "properties": {
        "installRoot": { "$ref": "#/$defs/nullableAbsolutePath" },
        "stateRoot": { "$ref": "#/$defs/nullableAbsolutePath" },
        "configRoot": { "$ref": "#/$defs/nullableAbsolutePath" },
        "dataRoot": { "$ref": "#/$defs/nullableAbsolutePath" }
      }
    },
    "fabric": {
      "type": "object",
      "required": ["groupID", "groupName", "peerCount", "connectedPeerCount"],
      "properties": {
        "groupID": {
          "anyOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "groupName": {
          "anyOf": [
            { "type": "string", "maxLength": 120 },
            { "type": "null" }
          ]
        },
        "peerCount": { "$ref": "#/$defs/count" },
        "connectedPeerCount": { "$ref": "#/$defs/count" }
      }
    },
    "work": {
      "type": "object",
      "required": [
        "sessionCount",
        "activeTurnCount",
        "agentCount",
        "scheduledRunCount",
        "pendingCommandCount"
      ],
      "properties": {
        "sessionCount": { "$ref": "#/$defs/count" },
        "activeTurnCount": { "$ref": "#/$defs/count" },
        "agentCount": { "$ref": "#/$defs/count" },
        "scheduledRunCount": { "$ref": "#/$defs/count" },
        "pendingCommandCount": { "$ref": "#/$defs/count" }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "currentReleaseID",
        "previousReleaseID",
        "stagedReleaseID",
        "updateEpisode"
      ],
      "properties": {
        "currentReleaseID": { "$ref": "#/$defs/nullableReleaseID" },
        "previousReleaseID": { "$ref": "#/$defs/nullableReleaseID" },
        "stagedReleaseID": { "$ref": "#/$defs/nullableReleaseID" },
        "updateEpisode": {
          "anyOf": [
            { "$ref": "#/$defs/updateEpisode" },
            { "type": "null" }
          ]
        }
      }
    },
    "secrets": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/secretMetadata" }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "deviceID": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": { "type": "integer", "minimum": 0 },
    "nullableAbsolutePath": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 500,
          "pattern": "^/[^\\u0000-\\u001f]*$"
        },
        { "type": "null" }
      ]
    },
    "releaseID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "nullableReleaseID": {
      "anyOf": [
        { "$ref": "#/$defs/releaseID" },
        { "type": "null" }
      ]
    },
    "updateEpisode": {
      "type": "object",
      "required": [
        "episodeID",
        "phase",
        "fromReleaseID",
        "toReleaseID",
        "startedAt",
        "updatedAt",
        "explicitResolutionRequired",
        "health"
      ],
      "properties": {
        "episodeID": { "$ref": "#/$defs/uuid" },
        "phase": {
          "enum": [
            "draining_old_release",
            "activating_new_release",
            "probation_new_release",
            "committed",
            "rolled_back",
            "aborted"
          ]
        },
        "fromReleaseID": { "$ref": "#/$defs/releaseID" },
        "toReleaseID": { "$ref": "#/$defs/releaseID" },
        "startedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "explicitResolutionRequired": { "type": "boolean" },
        "health": { "enum": ["pending", "passed", "failed", "not_applicable"] }
      }
    },
    "secretMetadata": {
      "type": "object",
      "required": [
        "secretID",
        "kind",
        "backend",
        "configured",
        "storedVersion",
        "effectiveVersion",
        "pendingRestart",
        "updatedAt"
      ],
      "properties": {
        "secretID": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "kind": {
          "enum": ["provider_api_key", "webhook_url", "oauth_token", "other"]
        },
        "backend": {
          "enum": ["linux-file-0600", "macos-keychain", "windows-password-vault", "unavailable"]
        },
        "configured": { "type": "boolean" },
        "storedVersion": { "type": "integer", "minimum": 0 },
        "effectiveVersion": { "type": "integer", "minimum": 0 },
        "pendingRestart": { "type": "boolean" },
        "updatedAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
