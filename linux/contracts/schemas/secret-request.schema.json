{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:converse:linux:secret-request:v1",
  "title": "Converse Linux dedicated secret-stdin header v1",
  "type": "object",
  "required": [
    "secretApiVersion",
    "requestID",
    "operationID",
    "expectedDeviceID",
    "action",
    "secretID",
    "kind",
    "valueByteCount",
    "valueSHA256"
  ],
  "properties": {
    "secretApiVersion": { "const": 1 },
    "requestID": { "$ref": "#/$defs/uuid" },
    "operationID": { "$ref": "#/$defs/uuid" },
    "expectedDeviceID": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "action": { "enum": ["set", "delete"] },
    "secretID": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "kind": {
      "anyOf": [
        { "enum": ["provider_api_key", "webhook_url", "oauth_token", "other"] },
        { "type": "null" }
      ]
    },
    "valueByteCount": { "type": "integer", "minimum": 0, "maximum": 16384 },
    "valueSHA256": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "set" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "kind": { "enum": ["provider_api_key", "webhook_url", "oauth_token", "other"] },
          "valueByteCount": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "valueSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "delete" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "kind": { "type": "null" },
          "valueByteCount": { "const": 0 },
          "valueSHA256": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    }
  }
}
