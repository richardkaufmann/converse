{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:converse:linux:secret-response:v1",
  "title": "Converse Linux dedicated secret-stdin response v1",
  "type": "object",
  "required": ["secretApiVersion", "requestID", "ok", "receipt", "error"],
  "properties": {
    "secretApiVersion": { "const": 1 },
    "requestID": { "$ref": "#/$defs/uuid" },
    "ok": { "type": "boolean" },
    "receipt": {
      "anyOf": [
        { "$ref": "#/$defs/receipt" },
        { "type": "null" }
      ]
    },
    "error": {
      "anyOf": [
        { "$ref": "#/$defs/error" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": {
        "properties": {
          "receipt": { "$ref": "#/$defs/receipt" },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "ok": { "const": false } },
        "required": ["ok"]
      },
      "then": {
        "properties": {
          "receipt": { "type": "null" },
          "error": { "$ref": "#/$defs/error" }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "receipt": {
      "type": "object",
      "required": [
        "operationID",
        "secretID",
        "kind",
        "backend",
        "configured",
        "storedVersion",
        "effectiveVersion",
        "pendingRestart",
        "updatedAt"
      ],
      "properties": {
        "operationID": { "$ref": "#/$defs/uuid" },
        "secretID": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "kind": {
          "enum": ["provider_api_key", "webhook_url", "oauth_token", "other"]
        },
        "backend": {
          "enum": ["linux-file-0600", "macos-keychain", "windows-password-vault", "unavailable"]
        },
        "configured": { "type": "boolean" },
        "storedVersion": { "type": "integer", "minimum": 0 },
        "effectiveVersion": { "type": "integer", "minimum": 0 },
        "pendingRestart": { "type": "boolean" },
        "updatedAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable", "uncertain"],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unsupported_secret_api",
            "identity_mismatch",
            "daemon_unavailable",
            "operation_conflict",
            "secret_not_found",
            "internal_error"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" },
        "uncertain": { "type": "boolean" }
      }
    }
  }
}
