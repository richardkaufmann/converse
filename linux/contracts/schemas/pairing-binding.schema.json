{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:converse:linux:pairing-binding:v1",
  "title": "Converse Linux transient pairing binding v1",
  "type": "object",
  "required": [
    "bindingVersion",
    "pairingID",
    "requestCorrelationID",
    "nativeRequestID",
    "role",
    "state",
    "linuxDeviceID",
    "requesterDeviceID",
    "sponsorDeviceID",
    "peerName",
    "linuxPublicKeyFingerprint",
    "requesterPublicKeyFingerprint",
    "sponsorPublicKeyFingerprint",
    "groupID",
    "groupName",
    "requesterConnectionInstanceID",
    "sponsorConnectionInstanceID",
    "verificationCode",
    "verificationCodeFingerprint",
    "expiresAt",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "bindingVersion": { "const": 1 },
    "pairingID": { "$ref": "#/$defs/uuid" },
    "requestCorrelationID": { "$ref": "#/$defs/uuid" },
    "nativeRequestID": { "$ref": "#/$defs/nullableUuid" },
    "role": { "enum": ["joiner", "reviewer"] },
    "state": {
      "enum": [
        "connecting",
        "awaiting_user",
        "awaiting_peer",
        "approved",
        "completed",
        "rejected",
        "expired",
        "failed"
      ]
    },
    "linuxDeviceID": { "$ref": "#/$defs/deviceID" },
    "requesterDeviceID": { "$ref": "#/$defs/deviceID" },
    "sponsorDeviceID": { "$ref": "#/$defs/deviceID" },
    "peerName": { "type": "string", "maxLength": 200 },
    "linuxPublicKeyFingerprint": { "$ref": "#/$defs/deviceID" },
    "requesterPublicKeyFingerprint": { "$ref": "#/$defs/deviceID" },
    "sponsorPublicKeyFingerprint": { "$ref": "#/$defs/deviceID" },
    "groupID": { "$ref": "#/$defs/uuid" },
    "groupName": {
      "anyOf": [
        { "type": "string", "maxLength": 120 },
        { "type": "null" }
      ]
    },
    "requesterConnectionInstanceID": { "$ref": "#/$defs/nullableUuid" },
    "sponsorConnectionInstanceID": { "$ref": "#/$defs/nullableUuid" },
    "verificationCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{4}( [0-9a-f]{4}){7}$"
        },
        { "type": "null" }
      ]
    },
    "verificationCodeFingerprint": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "properties": { "state": { "const": "awaiting_user" } },
          "required": ["state"]
        }
      },
      "then": {
        "properties": { "verificationCode": { "type": "null" } }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "nullableUuid": {
      "anyOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "deviceID": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
